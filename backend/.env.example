# ── Required ──────────────────────────────────────────────────────────────
PARALLEL_API_KEY=your-parallel-api-key-here

# ── Optional: Auth ────────────────────────────────────────────────────────
# INTERNAL_API_KEY=          # Header auth for mutating endpoints; leave unset for local dev

# ── Optional: City & Reference Point ─────────────────────────────────────
# CITY=San Francisco, CA
# CITY_SHORT=San Francisco
# REFERENCE_POINT_NAME=Caltrain · 4th & King
# REFERENCE_POINT_LAT=37.7764
# REFERENCE_POINT_LNG=-122.3973

# ── Optional: Map Defaults ────────────────────────────────────────────────
# MAP_CENTER_LAT=37.7764
# MAP_CENTER_LNG=-122.3973
# MAP_ZOOM=13

# ── Optional: Search Defaults ─────────────────────────────────────────────
# SEARCH_BUDGET=7500
# SEARCH_QUERY=apartments for rent in San Francisco
# SEARCH_INTERVAL_SECONDS=300
# SEARCH_BEDROOMS=

# ── Optional: Spam / Filtering ────────────────────────────────────────────
# SPAM_HIDE_THRESHOLD=50

# ── Optional: Listing Sites & Blocked Domains ────────────────────────────
# LISTING_SITES=trulia.com,craigslist.org,hotpads.com,rent.com,...
# BLOCKED_DOMAINS=zillow.com,apartments.com,yelp.com

# ── Optional: Geocoding Bounds ────────────────────────────────────────────
# GEO_COUNTRY=us
# GEO_LAT_MIN=37.5
# GEO_LAT_MAX=38.0
# GEO_LNG_MIN=-122.6
# GEO_LNG_MAX=-122.3

# ── Optional: Branding ───────────────────────────────────────────────────
# APP_TITLE=San Francisco Apartment Finder
# BRAND_NAME=Parallel
# BRAND_TAGLINE=AI Apartment Search
# BRAND_LOGO_URL=/parallel-logo.svg
# BRAND_DISCLAIMER=Powered by Parallel Web Systems · parallel.ai

# ── Optional: Search Suggestions (pipe-separated) ────────────────────────
# SEARCH_SUGGESTIONS=3-bedroom near transit...|Pet-friendly studio...|...

# ── Optional: Per-Bedroom Rent Floors ─────────────────────────────────────
# RENT_FLOORS=0:1900,1:2700,2:3600,3:5200,4:6500,5:8000

# ── Optional: Staleness Signals ───────────────────────────────────────────
# AGGREGATOR_SOURCES=trulia,hotpads,padmapper,rentcafe,rent,showcase
# STALE_AGGREGATOR_DAYS=14
# STALE_DIRECT_DAYS=45

# ── Optional: Monitor API ────────────────────────────────────────────────
# MONITOR_FREQUENCY=1h            # 1h / 6h / 1d / 1w / 30d
# MONITOR_PROCESSOR=base          # lite / base
# MONITOR_POLL_SECONDS=60
# MONITOR_INCLUDE_BACKFILL=true

# ── Optional: Task / FindAll Processors ───────────────────────────────────
# TASK_SPAM_PROCESSOR=pro
# FINDALL_GENERATOR=pro           # pro / core / preview

# ── Optional: Parallel API Base URL ───────────────────────────────────────
# PARALLEL_API_BASE=https://api.parallel.ai

# ── Optional: Database ───────────────────────────────────────────────────
# SQLITE_PATH=data/listings.db

# ── Optional: CORS ───────────────────────────────────────────────────────
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
