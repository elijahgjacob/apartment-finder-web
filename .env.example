# Required
PARALLEL_API_KEY=your-parallel-api-key-here

# Auth: shared secret required as `x-api-key` header on POST /api/tasks.
# Leave unset for local dev (auth bypassed).
INTERNAL_API_KEY=

# CORS — comma-separated origins allowed to call the API (set in production).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Search defaults
SEARCH_QUERY=apartments for rent in San Francisco
SEARCH_BUDGET=5000

# City / location (the default city a search targets; users can override per search)
CITY=San Francisco, CA
CITY_SHORT=San Francisco

# Reference point (used for scoring proximity)
REFERENCE_POINT_NAME=Caltrain · 4th & King
REFERENCE_POINT_LAT=37.7764
REFERENCE_POINT_LNG=-122.3973

# Map defaults (falls back to reference point if not set)
MAP_CENTER_LAT=37.7764
MAP_CENTER_LNG=-122.3973
MAP_ZOOM=13

# Geocoding country (ISO code) for the OpenStreetMap Nominatim lookups
GEO_COUNTRY=us

# Listing sites to recognise as sources (comma-separated domains)
LISTING_SITES=trulia.com,craigslist.org,hotpads.com,rent.com,redfin.com,realtor.com,padmapper.com,rentcafe.com,zumper.com,movoto.com,rentberry.com,showcase.com,compass.com

# Domains to reject outright (aggregators/spam)
BLOCKED_DOMAINS=zillow.com,apartments.com,yelp.com

# App branding (derived from CITY_SHORT if not set)
APP_TITLE=Apartment Finder

# NOTE: This app is stateless — it keeps no database. Each search runs live and
# streams results to the browser; a user's saved shortlist lives only in their
# own browser (localStorage). There is nothing to back up or persist server-side.
